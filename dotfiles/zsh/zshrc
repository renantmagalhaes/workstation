# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Load the tiny deferral scheduler before startup work. The installer keeps
# this plugin in Oh My Zsh's custom plugin directory.
ZSH_DEFER_PLUGIN="${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-defer/zsh-defer.plugin.zsh"
[[ -r "$ZSH_DEFER_PLUGIN" ]] && source "$ZSH_DEFER_PLUGIN"
unset ZSH_DEFER_PLUGIN

# Load configs
[[ -f ~/.zsh/main.zsh ]] && source ~/.zsh/main.zsh
[[ -f ~/.zsh/programs.zsh ]] && source ~/.zsh/programs.zsh
[[ -f ~/.zsh/functions.zsh ]] && source ~/.zsh/functions.zsh
[[ -f ~/.zsh/extras.zsh ]] && source ~/.zsh/extras.zsh
source $ZSH/oh-my-zsh.sh
[[ -f ~/.zsh/aliases.zsh ]] && source ~/.zsh/aliases.zsh

# zoxide
if (( $+commands[zoxide] )); then
  if (( $+functions[zsh-defer] )); then
    # Run after the first idle cycle: zoxide is useful, but it needn't delay
    # the first prompt. Default zsh-defer refresh actions keep ZLE in sync.
    zsh-defer -t 0.05 -c 'eval "$(zoxide init zsh)"'
  else
    eval "$(zoxide init zsh)"
  fi
fi

# Oh my posh
eval "$(oh-my-posh init zsh --config $HOME/.config/omp/oh-my-posh-minimal.yaml)"
